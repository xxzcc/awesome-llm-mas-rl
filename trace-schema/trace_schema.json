{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xxzcc/awesome-llm-mas-rl/blob/main/trace-schema/trace_schema.json",
  "title": "LLM-MAS Orchestration Trace",
  "type": "object",
  "required": ["trace_id", "task_id", "events", "edges", "rewards", "costs"],
  "additionalProperties": false,
  "properties": {
    "trace_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "system": {"type": "string"},
    "topology": {
      "type": "string",
      "enum": ["centralized", "planner_executor_critic", "debate", "swarm", "hierarchical", "harness", "mixed", "unknown"]
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/event"}
    },
    "edges": {
      "type": "array",
      "items": {"$ref": "#/$defs/edge"}
    },
    "rewards": {
      "type": "object",
      "additionalProperties": {"type": "number"},
      "description": "Reward channels keyed by credit layer or reward family, e.g. team, process, tool, orchestration."
    },
    "costs": {
      "type": "object",
      "required": ["tokens", "wall_clock_s"],
      "additionalProperties": {"type": "number"},
      "properties": {
        "tokens": {"type": "number", "minimum": 0},
        "wall_clock_s": {"type": "number", "minimum": 0},
        "tool_calls": {"type": "number", "minimum": 0},
        "messages": {"type": "number", "minimum": 0}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {"type": "number"},
      "description": "Optional benchmark metrics such as task_success, parallelism_efficiency, protocol_overhead, or error_amplification."
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "required": ["id", "t", "type", "agent"],
      "additionalProperties": true,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "t": {"type": "number", "minimum": 0},
        "type": {
          "type": "string",
          "enum": ["orchestrator_decision", "spawn", "despawn", "message", "tool_call", "tool_result", "return", "aggregate", "human_intervention", "safety_event"]
        },
        "agent": {"type": "string", "minLength": 1},
        "role": {"type": "string"},
        "from": {"type": "string"},
        "to": {"type": "string"},
        "tool": {"type": "string"},
        "content_ref": {
          "type": "string",
          "description": "Pointer or hash for text/tool content; raw content can be omitted for privacy."
        },
        "trusted": {"type": "boolean"}
      }
    },
    "edge": {
      "type": "object",
      "required": ["src", "dst", "type"],
      "additionalProperties": false,
      "properties": {
        "src": {"type": "string", "minLength": 1},
        "dst": {"type": "string", "minLength": 1},
        "type": {
          "type": "string",
          "enum": ["temporal", "causal", "spawn", "message", "tool_dependency", "return", "aggregate", "safety_flow"]
        }
      }
    }
  }
}
